# BS3_1 및 BS12_47 '모름, 무응답'(9) 제거
df_003 <- df_003 %>% filter(BS3_1 != 9 & BS12_47 != 9)

# smoker(흡연자) 변수 생성(0: 비흡연자, 1: 흡연자)
