# 병렬처리 코어 설정
cl <- makeCluster(parallel::detectCores()-1)
registerDoParallel(cl)

# 데이터 폴더 경로 설정
path_001<-'D:/github'
# 경로 내 hn으로 시작하는 SAS 파일 목록 추출
